{
  "manifest_version": 3,
  "name": "KOT-ScanDeck",
  "version": "5.4",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "clipboardRead"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*.github.io/*",
      "https://*.vercel.app/*",
      "https://*.thirunabimadh.in/*"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "runsheet.js", "auditor.js"],
      "run_at": "document_end"
    }
  ]
}