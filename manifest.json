{
  "manifest_version": 3,
  "name": "KOT-ScanDeck",
  "version": "5.5",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js", "runsheet.js", "auditor.js"],
      "run_at": "document_end"
    }
  ]
}