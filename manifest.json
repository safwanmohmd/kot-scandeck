{
  "manifest_version": 3,
  "name": "KOT-ScanDeck",
  "short_name": "KOT",
  "version": "3.0",
  "description": "Logistics scanning deck auto-injector extension with custom exclusion filters, version auto-updates, and custom audio RTO alert.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js" , "runsheet.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["alarm.mp3"],
      "matches": ["<all_urls>"]
    }
  ]
}